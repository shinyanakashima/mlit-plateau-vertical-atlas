{
  "name": "plateau-vertical-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b && oxlint src",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "data:synthetic": "python3 pipeline/build_synthetic.py",
    "data:tokyo": "python3 pipeline/build_atlas.py tokyo-station",
    "data:shinjuku": "python3 pipeline/build_atlas.py nishi-shinjuku",
    "data:reference": "python3 pipeline/build_reference.py",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.3.1",
    "cesium": "^1.146.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zarrita": "^0.7.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.5"
  }
}
